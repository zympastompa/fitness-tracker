{
  "name": "fitness-tracker",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install",
    "e2e:typecheck": "tsc -p tsconfig.json",
    "e2e:ci": "npm run e2e:typecheck && npm run e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
